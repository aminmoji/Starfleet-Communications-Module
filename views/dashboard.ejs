                    <%- include("./partials/nav.ejs") %>
				</div>
				<div class="bar-panel first-bar-panel">
					<div class="bar-1"></div>
					<div class="bar-2"></div>
					<div class="bar-3"></div>
					<div class="bar-4"></div>
					<div class="bar-5"></div>
				</div>
			</div>
		</div>
		<div class="wrap" id="gap">
			<div class="left-frame">
				<div>
					<div class="panel-3">03<span class="hop">-111968</span></div>
					<div class="panel-4">04<span class="hop">-041969</span></div>
					<div class="panel-5">05<span class="hop">-1701D</span></div>
					<div class="panel-6">06<span class="hop">-071984</span></div>
					<div class="panel-7">07<span class="hop">-081940</span></div>
					<div class="panel-8">08<span class="hop">-47148</span></div>
					<div class="panel-9">09<span class="hop">-081966</span></div>
				</div>
				<div>
					<div class="panel-10">10<span class="hop">-31</span></div>
				</div>
			</div>
			<div class="right-frame">
				<div class="bar-panel">
					<div class="bar-6"></div>
					<div class="bar-7"></div>
					<div class="bar-8"></div>
					<div class="bar-9"></div>
					<div class="bar-10"></div>
				</div>
				<main>

					<div data-current-user-id="<%= user._id %>">
                        <h1>Welcome, <%= user.rank %> <%= user.lastname %></h1>
                        <p>Select a crew member to open a private real-time channel.</p>

                        <form action="/dashboard" method="GET" class="crew-search" role="search">
                            <label>
                                <span class="hop">Search crew</span>
                                <input type="search" name="q" value="<%= query %>" placeholder="Name, rank, ship, or species" maxlength="60">
                            </label>
                            <input type="submit" value="Search">
                            <% if (query) { %>
                                <a href="/dashboard">Clear search</a>
                            <% } %>
                        </form>

                        <% if (users.length) { %>
                            <ul class="crew-grid">
                                <% for (const crewMember of users) { %>
                                    <li>
                                        <button
                                            type="button"
                                            class="user-list"
                                            data-id="<%= crewMember._id %>"
                                            data-label="<%= crewMember.rank %> <%= crewMember.lastname %>"
                                        >
                                            <img src="<%= crewMember.image || '/default-avatar.svg' %>" alt="">
                                            <span>
                                                <strong><%= crewMember.rank %> <%= crewMember.firstname %> <%= crewMember.lastname %></strong>
                                                <span class="presence <%= crewMember.is_online ? 'online-status' : 'offline-status' %>" id="<%= crewMember._id %>-status">
                                                    <%= crewMember.is_online ? "Online" : "Offline" %> · <%= crewMember.ship %>
                                                </span>
                                            </span>
                                        </button>
                                    </li>
                                <% } %>
                            </ul>
                        <% } else { %>
                            <p class="notice">No crew members match this search.</p>
                        <% } %>

                        <section class="chat-section" aria-label="Conversation" hidden>
                            <header class="comms-header">
                                <span class="comms-rail">COMMS // 47</span>
                                <div>
                                    <p class="comms-kicker">PRIVATE SUBSPACE CHANNEL</p>
                                    <h2 class="tagLine">Secure channel</h2>
                                </div>
                                <span id="channel-state" class="channel-state">INITIALIZING</span>
                            </header>
                            <p id="chat-status" class="comms-status" aria-live="polite"></p>
                            <div id="chat-container" aria-live="polite" aria-label="Encrypted conversation"></div>
                            <section class="call-console" aria-label="Call controls">
                                <div class="call-actions">
                                    <button type="button" id="voice-call">Audio</button>
                                    <button type="button" id="video-call">Video</button>
                                    <button type="button" id="enable-notifications">Alerts</button>
                                    <button type="button" id="end-call" class="end-call" hidden>End channel</button>
                                </div>
                                <p id="call-status" aria-live="polite">Calls are encrypted peer-to-peer.</p>
                                <div id="incoming-call" class="incoming-call" hidden>
                                    <strong>Incoming transmission</strong>
                                    <button type="button" id="accept-call">Accept</button>
                                    <button type="button" id="decline-call">Decline</button>
                                </div>
                            </section>
                            <div class="call-media" hidden>
                                <video id="remote-video" autoplay playsinline aria-label="Remote video"></video>
                                <video id="local-video" autoplay muted playsinline aria-label="Local video"></video>
                            </div>
                            <form id="chat-form" class="message-console">
                                <label class="hop" for="message">Transmission</label>
                                <div class="message-controls">
                                    <input type="text" name="message" placeholder="Type encrypted transmission" id="message" maxlength="1000" autocomplete="off">
                                    <label class="attachment-control" for="attachment">Attach <input type="file" id="attachment" accept="image/*,.pdf,.txt,.zip,audio/*"></label>
                                    <button type="submit" id="send-message">Transmit</button>
                                </div>
                            </form>
                        </section>
					</div>
				</main>
			</div>
		</div>
	</section>
	<script src="/socket.io/socket.io.js"></script>
	<script src="/chat.js"></script>
	<script src="/lcars.js"></script>
</body>

</html>
